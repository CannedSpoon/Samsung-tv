<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quiet Home - a fast, minimal home screen for a Samsung Tizen TV.
  Package QuietHome1: app QuietHome1.Home and service QuietHome1.Photos (the
  photo website, Glass Home's service). Public-level privileges only, so it
  installs with the free Samsung developer (public distributor) certificate.
  The service has no on-boot start (that needs a Partner certificate): the app
  starts it.

  Network use: the photo website on 127.0.0.1:8090 and, only if weather is
  turned on, api.open-meteo.com. The access rule is "*" as in Glass Home and
  Arn0, the form tested on TVs; the code reaches nothing else.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://quiet-home.local/app" version="1.2.0" viewmodes="maximized">
    <tizen:application id="QuietHome1.Home" package="QuietHome1" required_version="3.0"/>
    <name>Quiet Home</name>
    <description>A dock of your apps and inputs over rotating nature photos. No ads, no tracking.</description>
    <content src="index.html"/>
    <icon src="icon.png"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>

    <access origin="*" subdomains="true"/>

    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>

    <tizen:profile name="tv-samsung"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/multitasking.support" value="true"/>

    <tizen:service id="QuietHome1.Photos">
        <tizen:content src="service/index.js"/>
        <tizen:name>Photos</tizen:name>
        <tizen:description>Quiet Home photo and shortcut website on port 8090</tizen:description>
    </tizen:service>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
